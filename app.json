{
  "expo": {
    "name": "DormChef",
    "slug": "dormchef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bt.edu.cst.dormchef",
      "infoPlist": {
        "NSCameraUsageDescription": "DormChef uses the camera to scan barcodes when adding pantry items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bt.edu.cst.dormchef",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#52663C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DormChef uses the camera to scan barcodes."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "dormchef",
    "newArchEnabled": true,
    "extra": {
      "router": {}
    }
  }
}